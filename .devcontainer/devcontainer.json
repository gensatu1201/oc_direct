{
  "name": "OpenClaw Direct",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  
  // 1. Install OpenClaw AND create the persistent link
  // Note: We install @latest to ensure they have the exact version you're demoing.
  "postCreateCommand": "sudo npm install -g openclaw@latest && mkdir -p /workspaces/oc_direct/.openclaw_data && ln -sfn /workspaces/oc_direct/.openclaw_data ~/.openclaw",
  
  // 2. Automatically try to start the gateway when the codespace wakes up
  // It will only succeed AFTER they run 'onboard', which is perfect for a demo.
  "postStartCommand": "openclaw gateway run > /tmp/openclaw_boot.log 2>&1 &",

  "customizations": {
    "vscode": {
      "extensions": [
        "isabea.openclaw-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "forwardPorts": [18789],
  "remoteUser": "node"
}